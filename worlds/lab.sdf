<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lab">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.55 0 0.125 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 1.0 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 1.0 0.25</size></box></geometry>
          <material><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <model name="tube_red">
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><publish_link_pose>false</publish_link_pose><use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>20</update_frequency></plugin>
      <pose>0.45 -0.25 0.30 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.02</mass>
          <inertia><ixx>1.8e-5</ixx><iyy>1.8e-5</iyy><izz>2.3e-6</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
          <material><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="tube_green">
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><publish_link_pose>false</publish_link_pose><use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>20</update_frequency></plugin>
      <pose>0.45 -0.15 0.30 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.02</mass>
          <inertia><ixx>1.8e-5</ixx><iyy>1.8e-5</iyy><izz>2.3e-6</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
          <material><diffuse>0.1 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="tube_blue">
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><publish_link_pose>false</publish_link_pose><use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>20</update_frequency></plugin>
      <pose>0.45 -0.05 0.30 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.02</mass>
          <inertia><ixx>1.8e-5</ixx><iyy>1.8e-5</iyy><izz>2.3e-6</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
          <material><diffuse>0.1 0.2 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="zone_red">
      <static>true</static>
      <pose>0.45 0.15 0.2525 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.07 0.07 0.005</size></box></geometry>
        <material><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="zone_green">
      <static>true</static>
      <pose>0.45 0.25 0.2525 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.07 0.07 0.005</size></box></geometry>
        <material><diffuse>0.1 0.8 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="zone_blue">
      <static>true</static>
      <pose>0.45 0.35 0.2525 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.07 0.07 0.005</size></box></geometry>
        <material><diffuse>0.1 0.2 0.9 1</diffuse></material></visual></link>
    </model>

  </world>
</sdf>
